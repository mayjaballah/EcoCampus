<!-- ========== PAGE MOT DE PASSE OUBLIE ========== -->
<section class="page" id="forgot-password">
 <div class="hero !flex !flex-col !items-center !justify-center text-center">
  <i class="orb o1"></i><i class="orb o2"></i>
  <h1 class="ttl"><span style="--i:0">E</span><span style="--i:1">c</span><span style="--i:2">o</span><span class="g" style="--i:3">C</span><span class="g" style="--i:4">a</span><span class="g" style="--i:5">m</span><span class="g" style="--i:6">p</span><span class="g" style="--i:7">u</span><span class="g" style="--i:8">s</span></h1>
  <div class="bar"></div>
  <div class="card login" id="vue-forgot-password">
   <div class="logo" style="justify-content:center;margin-bottom:14px"><i><svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-14 14zM5 19l7-7"/></svg></i></div>
   <h2>Mot de passe oublié ?</h2>
   <p class="sub" style="margin-bottom:26px">Entrez votre adresse e-mail pour recevoir un code de vérification.</p>

   <form ref="formEl" action="php/forgot_password.php" method="POST" @submit="verifierFormulaire">
    <label for="reset-email" class="d-block text-start fw-medium">Adresse e-mail
     <input
       type="email"
       id="reset-email"
       name="email"
       v-model="email"
       @input="erreur = ''"
       class="block w-full rounded-full border border-green-900 bg-[#0a1a14] text-green-100 placeholder-green-300/60 px-6 py-3 mt-1 mb-2 font-medium focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500"
       placeholder="exemple@gmail.com"
       required
     ></label>

    <p v-if="erreur" style="color:#f87171;font-size:13px;margin:4px 0 12px;text-align:left;">
      {{ erreur }}
    </p>

    <button type="submit" class="block w-full rounded-full bg-[#0f3d2a] text-[#c8f7a0] font-semibold text-center px-6 py-3 mt-2 cursor-pointer transition hover:bg-[#14543a] focus:outline-none focus:ring-2 focus:ring-green-500">
      Envoyer le code
    </button>
   </form>
   
   <div class="login-links" style="margin-top: 15px;">
     <p><a href="#login">Retour à la connexion</a></p>
   </div>
  </div>
 </div>
</section>

<script>
(() => {
  const mountEl = document.getElementById('vue-forgot-password');
  if (!mountEl || !window.Vue) return;

  const { createApp, ref } = window.Vue;

  createApp({
    setup() {
      const email = ref('');
      const erreur = ref('');
      const formEl = ref(null);

      function verifierFormulaire(event) {
        const val = email.value.trim();
        if (!val) {
          event.preventDefault();
          erreur.value = 'Veuillez saisir votre adresse e-mail.';
          return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
          event.preventDefault();
          erreur.value = 'Adresse e-mail invalide.';
          return;
        }
        erreur.value = '';
      }

      return { email, erreur, formEl, verifierFormulaire };
    }
  }).mount(mountEl);
})();
</script>